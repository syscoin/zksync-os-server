diff --git a/da-contracts/contracts/SyscoinDAUtils.sol b/da-contracts/contracts/SyscoinDAUtils.sol
new file mode 100644
index 0000000000000000000000000000000000000000..87d8c9ee25483f5f92b5822397eef139bac53c0d
--- /dev/null
+++ b/da-contracts/contracts/SyscoinDAUtils.sol
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: MIT
+
+pragma solidity 0.8.28;
+
+// SYSCOIN: canonical compact Bitcoin-DA limits shared by the downstream validator.
+/// @dev Syscoin's raw data-hash availability precompile.
+address constant SYSCOIN_BITCOIN_DA_PRECOMPILE_ADDRESS = address(0x63);
+
+/// @dev Fixed gas charged by the Syscoin data-hash precompile.
+uint16 constant SYSCOIN_BITCOIN_DA_PRECOMPILE_GAS = 1400;
+
+/// @dev Size of one compact Bitcoin DA identifier.
+uint256 constant SYSCOIN_DA_REFERENCE_SIZE = 32;
+
+/// @dev Maximum number of 2 MiB Bitcoin DA blobs accepted for one batch.
+uint256 constant SYSCOIN_DA_MAX_BLOBS_PER_BATCH = 32;
diff --git a/da-contracts/contracts/SyscoinL1DAValidatorZKsyncOS.sol b/da-contracts/contracts/SyscoinL1DAValidatorZKsyncOS.sol
new file mode 100644
index 0000000000000000000000000000000000000000..f5485d3800dc09ee3001266ced2b7f02baf2a2b0
--- /dev/null
+++ b/da-contracts/contracts/SyscoinL1DAValidatorZKsyncOS.sol
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: MIT
+
+pragma solidity 0.8.28;
+
+import {IL1DAValidator, L1DAValidatorOutput} from "./IL1DAValidator.sol";
+import {
+    BitcoinDAPrecompileCallFailed,
+    BitcoinDAVerificationFailed,
+    InvalidBlobsDAInputLength,
+    InvalidBlobsPublished
+} from "./DAContractsErrors.sol";
+import {
+    SYSCOIN_BITCOIN_DA_PRECOMPILE_ADDRESS,
+    SYSCOIN_BITCOIN_DA_PRECOMPILE_GAS,
+    SYSCOIN_DA_MAX_BLOBS_PER_BATCH,
+    SYSCOIN_DA_REFERENCE_SIZE
+} from "./SyscoinDAUtils.sol";
+
+/// @title L1 DA validator for compact ZKsync OS commitments on Syscoin NEVM.
+/// @dev SYSCOIN: the operator supplies ordered 32-byte Bitcoin DA identifiers. Each identifier must be available through
+/// Syscoin's raw data-hash precompile, and their packed encoding must open the commitment emitted by ZKsync OS.
+contract SyscoinL1DAValidatorZKsyncOS is IL1DAValidator {
+    /// @inheritdoc IL1DAValidator
+    function checkDA(
+        uint256, // _chainId
+        uint256, // _batchNumber
+        bytes32 _l2DAValidatorOutputHash,
+        bytes calldata _operatorDAInput,
+        uint256 // _maxBlobsSupported
+    ) external view returns (L1DAValidatorOutput memory output) {
+        uint256 inputLength = _operatorDAInput.length;
+        if (
+            inputLength == 0 ||
+            inputLength % SYSCOIN_DA_REFERENCE_SIZE != 0 ||
+            inputLength / SYSCOIN_DA_REFERENCE_SIZE > SYSCOIN_DA_MAX_BLOBS_PER_BATCH
+        ) {
+            revert InvalidBlobsDAInputLength(inputLength);
+        }
+
+        for (uint256 offset = 0; offset < inputLength; offset += SYSCOIN_DA_REFERENCE_SIZE) {
+            _verifyBitcoinDA(bytes32(_operatorDAInput[offset:offset + SYSCOIN_DA_REFERENCE_SIZE]));
+        }
+
+        bytes32 publishedHash = keccak256(_operatorDAInput);
+        if (publishedHash != _l2DAValidatorOutputHash) {
+            revert InvalidBlobsPublished(publishedHash, _l2DAValidatorOutputHash);
+        }
+
+        output.stateDiffHash = bytes32(0);
+        output.blobsLinearHashes = new bytes32[](0);
+        output.blobsOpeningCommitments = new bytes32[](0);
+    }
+
+    function _verifyBitcoinDA(bytes32 _dataHash) internal view {
+        // This precompile consumes a raw 32-byte identifier rather than selector-prefixed ABI calldata.
+        (bool success, bytes memory result) = SYSCOIN_BITCOIN_DA_PRECOMPILE_ADDRESS.staticcall{
+            gas: SYSCOIN_BITCOIN_DA_PRECOMPILE_GAS
+        }(abi.encodePacked(_dataHash));
+
+        if (!success) {
+            revert BitcoinDAPrecompileCallFailed();
+        }
+        if (result.length != SYSCOIN_DA_REFERENCE_SIZE || bytes32(result) != _dataHash) {
+            revert BitcoinDAVerificationFailed();
+        }
+    }
+}
diff --git a/da-contracts/test/foundry/SyscoinL1DAValidatorZKsyncOS.t.sol b/da-contracts/test/foundry/SyscoinL1DAValidatorZKsyncOS.t.sol
new file mode 100644
index 0000000000000000000000000000000000000000..20c099cb7d1c28adb57b9f8295a391400bb4c048
--- /dev/null
+++ b/da-contracts/test/foundry/SyscoinL1DAValidatorZKsyncOS.t.sol
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+
+import {L1DAValidatorOutput} from "../../contracts/IL1DAValidator.sol";
+import {
+    BitcoinDAPrecompileCallFailed,
+    BitcoinDAVerificationFailed,
+    InvalidBlobsDAInputLength,
+    InvalidBlobsPublished
+} from "../../contracts/DAContractsErrors.sol";
+import {SyscoinL1DAValidatorZKsyncOS} from "../../contracts/SyscoinL1DAValidatorZKsyncOS.sol";
+import {
+    SYSCOIN_BITCOIN_DA_PRECOMPILE_ADDRESS,
+    SYSCOIN_DA_MAX_BLOBS_PER_BATCH
+} from "../../contracts/SyscoinDAUtils.sol";
+
+contract SyscoinL1DAValidatorZKsyncOSTest is Test {
+    SyscoinL1DAValidatorZKsyncOS internal validator;
+
+    function setUp() public {
+        validator = new SyscoinL1DAValidatorZKsyncOS();
+    }
+
+    function testCheckDAAcceptsOrderedAvailableReferences() public {
+        bytes32 firstHash = keccak256("first-bitcoin-da-blob");
+        bytes32 secondHash = keccak256("second-bitcoin-da-blob");
+        bytes memory operatorInput = abi.encodePacked(firstHash, secondHash);
+
+        _mockAvailable(firstHash);
+        _mockAvailable(secondHash);
+        vm.expectCall(SYSCOIN_BITCOIN_DA_PRECOMPILE_ADDRESS, abi.encodePacked(firstHash));
+        vm.expectCall(SYSCOIN_BITCOIN_DA_PRECOMPILE_ADDRESS, abi.encodePacked(secondHash));
+
+        // solhint-disable-next-line func-named-parameters
+        L1DAValidatorOutput memory output = validator.checkDA(1, 7, keccak256(operatorInput), operatorInput, 32);
+
+        assertEq(output.stateDiffHash, bytes32(0));
+        assertEq(output.blobsLinearHashes.length, 0);
+        assertEq(output.blobsOpeningCommitments.length, 0);
+    }
+
+    function testCheckDARejectsEmptyInput() public {
+        vm.expectRevert(abi.encodeWithSelector(InvalidBlobsDAInputLength.selector, 0));
+        // solhint-disable-next-line func-named-parameters
+        validator.checkDA(1, 7, keccak256(""), hex"", 32);
+    }
+
+    function testCheckDARejectsPartialReference() public {
+        bytes memory operatorInput = new bytes(31);
+        vm.expectRevert(abi.encodeWithSelector(InvalidBlobsDAInputLength.selector, operatorInput.length));
+        // solhint-disable-next-line func-named-parameters
+        validator.checkDA(1, 7, keccak256(operatorInput), operatorInput, 32);
+    }
+
+    function testCheckDARejectsMoreThanThirtyTwoReferences() public {
+        bytes memory operatorInput = new bytes((SYSCOIN_DA_MAX_BLOBS_PER_BATCH + 1) * 32);
+        vm.expectRevert(abi.encodeWithSelector(InvalidBlobsDAInputLength.selector, operatorInput.length));
+        // solhint-disable-next-line func-named-parameters
+        validator.checkDA(1, 7, keccak256(operatorInput), operatorInput, 32);
+    }
+
+    function testCheckDARejectsUnavailableReference() public {
+        bytes32 dataHash = keccak256("unavailable-bitcoin-da-blob");
+        bytes memory operatorInput = abi.encodePacked(dataHash);
+        vm.mockCall(SYSCOIN_BITCOIN_DA_PRECOMPILE_ADDRESS, operatorInput, hex"");
+
+        vm.expectRevert(BitcoinDAVerificationFailed.selector);
+        // solhint-disable-next-line func-named-parameters
+        validator.checkDA(1, 7, keccak256(operatorInput), operatorInput, 32);
+    }
+
+    function testCheckDARejectsWrongPrecompileResult() public {
+        bytes32 dataHash = keccak256("available-bitcoin-da-blob");
+        bytes memory operatorInput = abi.encodePacked(dataHash);
+        vm.mockCall(
+            SYSCOIN_BITCOIN_DA_PRECOMPILE_ADDRESS,
+            operatorInput,
+            abi.encodePacked(keccak256("different-bitcoin-da-blob"))
