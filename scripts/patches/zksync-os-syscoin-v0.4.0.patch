+                &mut oracle,
+                &mut resources,
+            )
+            .unwrap();
+        let resources_after_first = resources.clone();
+
+        assert!(storage
+            .apply_fee_ledger_write_impl(
+                &key(),
+                &value(40),
+                &value(30),
+                true,
+                &mut oracle,
+                &mut resources,
+            )
+            .is_err());
+        assert_eq!(resources, resources_after_first);
+        assert_eq!(
+            *storage.cache.get(&key()).unwrap().current().value(),
+            value(40)
+        );
+        assert_eq!(
