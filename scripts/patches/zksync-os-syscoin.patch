+    pub fn apply_syscoin_edge_da_refs_root_for_tx_numbers(
+        &self,
+        root: &mut Bytes32,
+        authorized_tx_numbers: &[u32],
+    ) {
+        // SYSCOIN: extend an existing ordered root with this block's authorized compact edge DA refs.
