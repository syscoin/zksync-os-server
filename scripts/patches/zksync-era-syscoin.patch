+fn owner_acceptance_required(
+    current_owner: Address,
+    pending_owner: Address,
+    expected_owner: Address,
+) -> anyhow::Result<bool> {
+    if current_owner == expected_owner {
+        if pending_owner == Address::zero() {
+            return Ok(false);
+        }
+        bail!("target is already owned by the governor but still has a pending owner");
+    }
+    if pending_owner != expected_owner {
+        bail!("governor is not the target's pending owner");
+    }
+    Ok(true)
