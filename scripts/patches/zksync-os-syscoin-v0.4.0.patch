+    for ref_hash in ref_hashes {
+        let mut hasher = crypto::sha3::Keccak256::new();
+        hasher.update(root.as_u8_ref());
+        hasher.update(ref_hash.as_u8_ref());
+        *root = hasher.finalize().into();
+    }
