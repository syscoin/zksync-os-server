+    )
+    .await?;
+    for target in [
+        contracts_config.bridges.shared.l1_address,
+        contracts_config
+            .core_ecosystem_contracts
+            .stm_deployment_tracker_proxy_addr
+            .context("stm_deployment_tracker_proxy_addr")?,
+    ] {
+        accept_owner(
+            shell,
+            foundry_path.clone(),
+            governance,
+            governor,
+            target,
+            forge_args,
+            l1_rpc_url.to_owned(),
+        )
+        .await?;
+    }
+    if let Some(target) = chain_asset_handler {
+        accept_owner(
+            shell,
+            foundry_path.clone(),
+            governance,
+            governor,
+            target,
+            forge_args,
+            l1_rpc_url.to_owned(),
+        )
+        .await?;
+    }
+
+    if !vm_option.is_zksync_os() {
+        return Ok(());
+    }
+
+    let deployer = wallets
+        .deployer
+        .as_ref()
+        .context("deployer wallet is required to complete core ownership")?;
+    let native_token_vault = contracts_config
+        .core_ecosystem_contracts
+        .native_token_vault_addr
+        .context("native_token_vault_addr")?;
+    let asset_tracker = native_token_vault_asset_tracker(native_token_vault, l1_rpc_url).await?;
+    let l1_nullifier = contracts_config
+        .bridges
+        .l1_nullifier_addr
+        .context("l1_nullifier_addr")?;
+    chain_asset_handler.context("chain_asset_handler_proxy_addr")?;
+    let chain_registration_sender =
+        bridgehub_chain_registration_sender(bridgehub, l1_rpc_url).await?;
+
+    ensure_pending_owner_from_deployer(
+        shell,
+        foundry_path.clone(),
+        deployer,
+        governance,
+        chain_registration_sender,
+        forge_args,
+        l1_rpc_url.to_owned(),
+    )
+    .await?;
+
+    for target in [asset_tracker, l1_nullifier, chain_registration_sender] {
+        accept_owner(
+            shell,
+            foundry_path.clone(),
+            governance,
+            governor,
+            target,
+            forge_args,
+            l1_rpc_url.to_owned(),
+        )
+        .await?;
+    }
+    accept_direct_owner(
+        shell,
+        foundry_path,
+        governor,
+        native_token_vault,
+        forge_args,
+        l1_rpc_url.to_owned(),
+    )
+    .await
+}
