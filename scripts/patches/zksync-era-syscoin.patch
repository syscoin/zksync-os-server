+// SYSCOIN: Exercise the complete raw-credential boundary without invoking
+// Forge, and ensure diagnostics never echo the supplied secret value.
+#[cfg(test)]
+mod syscoin_tests {
+    use super::*;
+
+    fn forge_args(arguments: &[&str]) -> ForgeScriptArgs {
+        ForgeScriptArgs {
+            additional_args: arguments
+                .iter()
+                .map(|argument| argument.to_string())
+                .collect(),
+            ..ForgeScriptArgs::default()
+        }
+    }
+
+    #[test]
+    fn broadcasts_are_serialized() {
+        let mut script = Forge::new(Path::new("."))
+            .script(Path::new("test.s.sol"), ForgeScriptArgs::default())
+            .with_broadcast();
+        assert_eq!(
+            script.args.build(),
+            vec![
+                ForgeScriptArg::Broadcast.to_string(),
+                ForgeScriptArg::Slow.to_string(),
+                ForgeScriptArg::Timeout {
+                    timeout: SYSCOIN_BROADCAST_TIMEOUT_SECONDS,
+                }
+                .to_string(),
+            ],
+        );
+    }
+
+    #[test]
+    fn generated_private_key_binds_only_its_public_sender() {
+        let private_key = H256::from_slice(&[7_u8; 32]);
+        let expected_sender = format!(
+            "--sender={:#x}",
+            LocalWallet::from_bytes(private_key.as_bytes())
+                .unwrap()
+                .address()
+        );
+        let secret = hex::encode(private_key.as_bytes());
+        let mut script = Forge::new(Path::new("."))
+            .script(Path::new("test.s.sol"), ForgeScriptArgs::default())
+            .with_private_key(private_key);
+
+        assert_eq!(script.private_key, Some(private_key));
+        script.bind_private_key_sender();
+        script.bind_private_key_sender();
+        let arguments = script.args.build();
+        assert_eq!(
+            arguments
+                .iter()
+                .filter(|argument| *argument == &expected_sender)
+                .count(),
+            1
+        );
+        assert!(!arguments.iter().any(|argument| argument.contains(&secret)));
+    }
+
+    #[test]
+    fn generated_private_key_preserves_explicit_sender() {
+        let private_key = H256::from_slice(&[8_u8; 32]);
+        let explicit_sender = "0x1111111111111111111111111111111111111111";
+        let mut script = Forge::new(Path::new("."))
+            .script(Path::new("test.s.sol"), ForgeScriptArgs::default())
+            .with_private_key(private_key)
+            .with_sender(explicit_sender.to_string());
+        script.bind_private_key_sender();
+        let arguments = script.args.build();
+
+        assert_eq!(
+            arguments
+                .iter()
+                .filter(|argument| argument.starts_with("--sender="))
+                .count(),
+            1
+        );
+        assert_eq!(arguments[0], format!("--sender={explicit_sender}"));
+    }
+
+    #[test]
+    fn replacing_generated_private_key_rebinds_sender() {
+        let first_private_key = H256::from_slice(&[7_u8; 32]);
+        let final_private_key = H256::from_slice(&[8_u8; 32]);
+        let expected_sender = format!(
+            "--sender={:#x}",
+            LocalWallet::from_bytes(final_private_key.as_bytes())
+                .unwrap()
+                .address()
+        );
+        let mut script = Forge::new(Path::new("."))
+            .script(Path::new("test.s.sol"), ForgeScriptArgs::default())
+            .with_private_key(first_private_key)
+            .with_private_key(final_private_key);
+
+        script.bind_private_key_sender();
+        assert_eq!(script.private_key, Some(final_private_key));
+        assert_eq!(script.args.build(), vec![expected_sender]);
+    }
+
+    #[test]
+    fn rejects_raw_secret_arguments_without_echoing_values() {
+        const SECRET: &str = "syscoin-secret-sentinel";
+        for flag in RAW_SECRET_ARGS {
+            let equals_argument = format!("{flag}={SECRET}");
+            for arguments in [vec![flag, SECRET], vec![equals_argument.as_str()]] {
+                let error = forge_args(&arguments)
+                    .reject_raw_secret_args()
+                    .expect_err("raw secret argument must be rejected")
+                    .to_string();
+                assert!(error.contains(flag));
+                assert!(!error.contains(SECRET));
+            }
+        }
+    }
+
+    #[test]
+    fn allows_non_secret_wallet_selectors() {
+        for arguments in [
+            vec!["--keystore", "/safe/signer.json"],
+            vec!["--keystore=/safe/signer.json"],
+            vec!["--account", "gateway"],
+            vec!["--password-file", "/safe/password"],
+            vec!["--ledger"],
+            vec!["--trezor"],
+            vec!["--aws"],
+            vec!["--gcp"],
+        ] {
+            forge_args(&arguments)
+                .reject_raw_secret_args()
+                .expect("non-secret selector must remain allowed");
+            assert!(forge_args(&arguments).wallet_args_passed());
+        }
+    }
+}
