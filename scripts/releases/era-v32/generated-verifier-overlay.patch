+                // PROOF_QUOTIENT_POLY_PARTS_3
+                {
+                    let x := mod(calldataload(add(offset, 0x2a4)), Q_MOD)
+                    let y := mod(calldataload(add(offset, 0x2c4)), Q_MOD)
