+        .checked_add(current_tx)
+        .ok_or_else(|| internal_error!("Syscoin edge DA ref count overflow"))?;
+    let next_batch = prior_blocks
+        .checked_add(next_block)
+        .ok_or_else(|| internal_error!("Syscoin edge DA ref count overflow"))?;
+    Ok((next_block, next_batch))
