+fn source_date_epoch_timestamp(epoch: &str) -> Result<String, String> {
+    let seconds = epoch
+        .parse::<i64>()
+        .map_err(|err| format!("{epoch:?} is not an integer: {err}"))?;
+    let timestamp = chrono::DateTime::from_timestamp(seconds, 0)
+        .ok_or_else(|| format!("{seconds} is outside chrono's supported range"))?;
+    Ok(timestamp.format("%Y-%m-%d %H:%M:%S").to_string())
+}
