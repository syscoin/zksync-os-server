+    /// The batch-count prefix is captured first so finishing needs no whole-vector copy.
+    pub fn new_bounded(
+        original_source: ZkEENonDeterminismSource,
+        max_words: usize,
+        prefix: u32,
+    ) -> Result<Self, WitnessCapacityError> {
+        let mut source = Self::new(original_source);
+        source.max_words = Some(max_words);
+        source.ensure_capture_capacity(1)?;
+        source.read_items.borrow_mut().push(prefix);
+        Ok(source)
+    }
