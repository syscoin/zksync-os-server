+        anyhow::bail!("migration protected sender differs from governor");
+    }
+    let public = Command::new("cast")
+        .args(["wallet", "address"])
+        .args(&account_args)
+        .output()
+        .context("protected migration account lookup failed")?;
+    if !public.status.success() || public.stdout.len() > 128 {
+        anyhow::bail!("protected migration account lookup failed");
+    }
+    let derived = std::str::from_utf8(&public.stdout)
+        .ok()
+        .map(str::trim)
+        .filter(|value| value.starts_with("0x") && value.len() == 42)
+        .and_then(|value| value.parse::<Address>().ok());
+    if derived != Some(sender) {
+        anyhow::bail!("protected migration account address differs from governor");
+    }
+    let provider = Provider::<Http>::try_from(&l1_rpc_url)?;
+    if provider.get_chainid().await? != U256::from(expected_chain_id) {
+        anyhow::bail!("migration settlement chain identity differs");
+    }
+    let nonce = provider.get_transaction_count(sender, None).await?;
+    let pending = provider
+        .get_transaction_count(sender, Some(ethers::types::BlockNumber::Pending.into()))
+        .await?;
+    if nonce != pending {
+        anyhow::bail!("migration governor has pending transactions");
+    }
+    if provider.get_transaction_count(sender, None).await? != nonce
+        || provider
+            .get_transaction_count(sender, Some(ethers::types::BlockNumber::Pending.into()))
+            .await?
+            != nonce
+        || provider.get_chainid().await? != U256::from(expected_chain_id)
+    {
+        anyhow::bail!("migration spend state changed before submission");
+    }
+    let mut command = Command::new("cast");
+    command.args([
+        "send",
+        "--async",
+        "--rpc-url",
+        &l1_rpc_url,
+        "--from",
+        &format!("{sender:#x}"),
+        "--chain",
+        &expected_chain_id.to_string(),
+        "--nonce",
+        &nonce.to_string(),
+        "--value",
+        &value.to_string(),
+        "--data",
+        &format!("0x{}", hex::encode(&data)),
+    ]);
+    // SYSCOIN: Retain Syscoin's native legacy fee policy without forcing it on Ethereum.
+    if matches!(expected_chain_id, 57 | 5700) {
+        command.arg("--legacy");
+    }
+    command.arg(format!("{to:#x}")).args(&account_args);
+    let result = command
+        .output()
+        .context("protected migration send outcome uncertain; do not retry")?;
+    if !result.status.success() || result.stdout.len() > 128 {
+        anyhow::bail!("protected migration send outcome uncertain; do not retry");
+    }
+    let hash = std::str::from_utf8(&result.stdout)
+        .ok()
+        .map(str::trim)
+        .filter(|value| value.starts_with("0x") && value.len() == 66)
+        .and_then(|value| value.parse::<H256>().ok())
+        .context("protected migration send hash unavailable; do not retry")?;
+    logger::info(format!("Transaction sent! Hash: {hash:#x}"));
+    let receipt = tokio::time::timeout(
+        std::time::Duration::from_secs(1800),
+        PendingTransaction::new(hash, &provider),
+    )
+    .await
+    .context("migration receipt wait expired; audit original hash without retry")??
+    .context("migration receipt not found; audit original hash without retry")?;
+    let tx = provider
+        .get_transaction(hash)
+        .await?
+        .context("migration transaction unavailable")?;
+    let number = receipt
+        .block_number
+        .context("migration receipt is not mined")?;
+    let block = provider
+        .get_block(number)
+        .await?
+        .context("migration canonical block unavailable")?;
+    validate_migration_receipt(
+        &receipt,
+        &tx,
+        &block,
+        to,
+        &data,
+        value,
+        sender,
+        nonce,
+        expected_chain_id,
+        hash,
+    )?;
+    if provider.get_chainid().await? != U256::from(expected_chain_id) {
+        anyhow::bail!("migration settlement chain changed; do not retry");
+    }
+    if provider
+        .get_block(number)
+        .await?
+        .and_then(|block| block.hash)
+        != receipt.block_hash
+    {
+        anyhow::bail!("migration receipt block changed; do not retry");
+    }
+    logger::info(format!("Transaction {hash:#x} completed!"));
+    Ok(receipt)
+}
+
+// SYSCOIN: Cast success/hash alone is not a migration receipt. Keep the exact
+// signed intention bound to status, full transaction and indexed canonical block.
+#[allow(clippy::too_many_arguments)]
+fn validate_migration_receipt(
+    receipt: &TransactionReceipt,
+    tx: &Transaction,
+    block: &Block<H256>,
+    to: Address,
+    data: &[u8],
+    value: U256,
+    sender: Address,
+    nonce: U256,
+    expected_chain_id: u64,
+    hash: H256,
+) -> anyhow::Result<()> {
+    let index = receipt.transaction_index.as_u64() as usize;
+    if receipt.status != Some(ethers::types::U64::from(1))
+        || receipt.transaction_hash != hash
+        || receipt.from != sender
+        || receipt.to != Some(to)
+        || tx.hash != hash
+        || tx.from != sender
+        || tx.to != Some(to)
+        || tx.nonce != nonce
+        || tx.value != value
+        || tx.input.as_ref() != data
+        || tx.chain_id != Some(U256::from(expected_chain_id))
+        || tx.block_hash != receipt.block_hash
+        || tx.block_number != receipt.block_number
+        || tx.transaction_index != Some(receipt.transaction_index)
+        || receipt.block_number.is_none()
+        || block.number != receipt.block_number
+        || block.hash.is_none()
+        || block.hash != receipt.block_hash
+        || index >= block.transactions.len()
+        || block.transactions[index] != hash
+        || block
+            .transactions
+            .iter()
+            .filter(|value| **value == hash)
+            .count()
+            != 1
+    {
+        anyhow::bail!(
+            "migration receipt does not prove the intended canonical transaction; do not retry"
+        );
+    }
+    Ok(())
+}
