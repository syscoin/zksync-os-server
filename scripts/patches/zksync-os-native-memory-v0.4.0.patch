+    pub fn get_capacity_error(&self) -> Rc<RefCell<Option<WitnessCapacityError>>> {
+        Rc::clone(&self.capacity_error)
+    }
+
+    /// SYSCOIN: Move the captured allocation; never clone a completed witness.
+    pub fn into_read_items(self) -> Vec<u32> {
+        std::mem::take(&mut *self.read_items.borrow_mut())
+    }
+
+    fn ensure_capture_capacity(&mut self, additional: usize) -> Result<(), WitnessCapacityError> {
+        let Some(max_words) = self.max_words else {
+            return Ok(());
+        };
+        let mut items = self.read_items.borrow_mut();
+        let required = items.len().checked_add(additional).unwrap_or(usize::MAX);
+        let error = if required > max_words || items.capacity() > max_words {
+            Some(WitnessCapacityError::LimitExceeded {
+                requested_words: required.max(items.capacity()),
+                max_words,
+            })
+        } else if required > items.capacity() {
+            // Vec's default geometric growth can exceed the byte reservation. Request
+            // an explicit capped capacity, and verify the allocator's actual result.
+            let target = items
+                .capacity()
+                .saturating_mul(2)
+                .max(8)
+                .max(required)
+                .min(max_words);
+            let reserve = target - items.len();
+            if items.try_reserve_exact(reserve).is_err() {
+                Some(WitnessCapacityError::AllocationFailed {
+                    requested_words: target,
+                    max_words,
+                })
+            } else if items.capacity() > max_words {
+                Some(WitnessCapacityError::LimitExceeded {
+                    requested_words: items.capacity(),
+                    max_words,
+                })
+            } else {
+                None
+            }
+        } else {
+            None
+        };
+        if let Some(error) = error {
+            *self.capacity_error.borrow_mut() = Some(error.clone());
+            return Err(error);
+        }
