+    /// Test-only adapter; never available in the unmodified release CLI.
+    /// The generator must own a fresh loopback Anvil, chain ID 31337.
+    pub fn with_anvil_component_sender(mut self, address: String) -> anyhow::Result<Self> {
+        anyhow::ensure!(
+            std::env::var("SYSCOIN_ANVIL_COMPONENT_ONLY").as_deref() == Ok("31337"),
