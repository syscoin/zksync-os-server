@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: MIT
+
+pragma solidity 0.8.28;
+
+import {IL1DAValidator, L1DAValidatorOutput} from "../chain-interfaces/IL1DAValidator.sol";
+import {IL2Bridgehub} from "../../core/bridgehub/IL2Bridgehub.sol";
+import {L2_BRIDGEHUB_ADDR, L2_TO_L1_MESSENGER_SYSTEM_CONTRACT} from "../../common/l2-helpers/L2ContractInterfaces.sol";
+import {
+    SYSCOIN_RELAYED_EDGE_DA_VALIDATOR_VERSION,
+    SYSCOIN_DA_REFERENCE_SIZE,
+    SYSCOIN_DA_MAX_REFS_PER_BATCH
+} from "../../common/SyscoinConfig.sol";
+import {
+    L1DAValidatorInvalidSender,
+    SyscoinEdgeDACommitmentMismatch,
+    SyscoinEdgeDARefInputMalformed
+} from "../L1StateTransitionErrors.sol";
+
+/// @notice Canonical Gateway relay for compact ordered Syscoin Bitcoin-DA hash references.
+/// @dev SYSCOIN: emits a versioned message that final L1 revalidates against the Bitcoin-DA precompile.
+contract SyscoinRelayedSLDAValidator is IL1DAValidator {
+    function _ensureOnlyChainSender(uint256 _chainId) internal view {
+        if (IL2Bridgehub(L2_BRIDGEHUB_ADDR).getZKChain(_chainId) != msg.sender) {
+            revert L1DAValidatorInvalidSender(msg.sender);
+        }
+    }
+
+    function checkDA(
+        uint256 _chainId,
+        uint256 _batchNumber,
+        bytes32 _l2DAValidatorOutputHash,
+        bytes calldata _operatorDAInput,
+        uint256
+    ) external returns (L1DAValidatorOutput memory output) {
+        _ensureOnlyChainSender(_chainId);
+
+        uint256 inputLength = _operatorDAInput.length;
+        if (
+            inputLength == 0 ||
+            inputLength % SYSCOIN_DA_REFERENCE_SIZE != 0 ||
+            inputLength / SYSCOIN_DA_REFERENCE_SIZE > SYSCOIN_DA_MAX_REFS_PER_BATCH
+        ) {
+            revert SyscoinEdgeDARefInputMalformed(0);
+        }
+
+        bytes32 actualCommitment = keccak256(_operatorDAInput);
+        if (actualCommitment != _l2DAValidatorOutputHash) {
+            revert SyscoinEdgeDACommitmentMismatch(_l2DAValidatorOutputHash, actualCommitment);
+        }
+
+        output.blobsLinearHashes = new bytes32[](0);
+        output.blobsOpeningCommitments = new bytes32[](0);
+
+        // slither-disable-next-line unused-return
+        L2_TO_L1_MESSENGER_SYSTEM_CONTRACT.sendToL1(
+            abi.encode(
+                SYSCOIN_RELAYED_EDGE_DA_VALIDATOR_VERSION,
+                _chainId,
+                _batchNumber,
+                _l2DAValidatorOutputHash,
+                _operatorDAInput
+            )
+        );
+    }
+}
diff --git a/l1-contracts/contracts/state-transition/data-availability/SyscoinRollupDAManager.sol b/l1-contracts/contracts/state-transition/data-availability/SyscoinRollupDAManager.sol
new file mode 100644
index 0000000000000000000000000000000000000000..653fd5d89c099e0019d3863a73a5137b05833a21
--- /dev/null
+++ b/l1-contracts/contracts/state-transition/data-availability/SyscoinRollupDAManager.sol
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {L2DACommitmentScheme} from "../../common/Config.sol";
+import {SYSCOIN_ROLLUP_L2_DA_COMMITMENT_SCHEME} from "../../common/SyscoinConfig.sol";
+import {RollupDAManager} from "./RollupDAManager.sol";
+
+/// @notice Rollup DA manager restricted to one Syscoin compact validator/scheme pair.
+/// @dev SYSCOIN: governance may disable or re-enable the canonical pair, but cannot authorize
+///      another validator or commitment scheme.
+contract SyscoinRollupDAManager is RollupDAManager {
+    address public immutable SYSCOIN_L1_DA_VALIDATOR;
+
+    constructor(address _syscoinL1DAValidator) {
+        require(_syscoinL1DAValidator != address(0), "Syscoin DA validator is zero");
+        SYSCOIN_L1_DA_VALIDATOR = _syscoinL1DAValidator;
+        isAllowedDAConfiguration[_syscoinL1DAValidator][SYSCOIN_ROLLUP_L2_DA_COMMITMENT_SCHEME] = true;
+        emit DAPairUpdated(_syscoinL1DAValidator, SYSCOIN_ROLLUP_L2_DA_COMMITMENT_SCHEME, true);
+    }
+
+    function updateDAPair(
+        address _l1DAValidator,
+        L2DACommitmentScheme _l2DACommitmentScheme,
+        bool _status
+    ) external override onlyOwner validDAConfiguration(_l1DAValidator, _l2DACommitmentScheme) {
+        require(_l1DAValidator == SYSCOIN_L1_DA_VALIDATOR, "Only the Syscoin DA validator is allowed");
+        require(
+            _l2DACommitmentScheme == SYSCOIN_ROLLUP_L2_DA_COMMITMENT_SCHEME,
+            "Only the Syscoin compact DA scheme is allowed"
+        );
+        isAllowedDAConfiguration[_l1DAValidator][_l2DACommitmentScheme] = _status;
+        emit DAPairUpdated(_l1DAValidator, _l2DACommitmentScheme, _status);
+    }
+}
