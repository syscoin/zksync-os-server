index 0000000000000000000000000000000000000000..94eb097feeb58e0569f4d3d76898bb7ef0e70fc3
--- /dev/null
+++ b/l1-contracts/contracts/state-transition/chain-interfaces/ISyscoinPriorityCommitPolicy.sol
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.21;
+
+error InvalidSyscoinPriorityCommitPolicy();
+error SyscoinPriorityCommitPolicyConflictsWithPriorityMode();
+error CannotRevertVerifiedSyscoinPriorityBatch();
+
+/// @notice Optional zkSYS priority admission for a specific native settlement diamond.
+interface ISyscoinPriorityCommitPolicy {
+    function chain() external view returns (address);
+    function initialBatch() external view returns (uint64);
+    function initialPriorityCursor() external view returns (uint64);
+    function initialStoredHash() external view returns (bytes32);
+
+    /// @notice Called by the settlement diamond before it stores the batch hash and advances its frontier.
+    function recordCommit(uint64 batchNumber, bytes32 storedHash, uint256 priorityCount, bytes32 priorityHash) external;
+
+    /// @notice Called by the settlement diamond before it rewinds its unverified commitment frontier.
+    function recordRevert(uint256 newLastBatch) external;
+}
