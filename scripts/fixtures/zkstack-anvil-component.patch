+            !self.args.additional_args.iter().any(|a| argument_uses_flag(a, "--sender") || argument_uses_flag(a, "--unlocked")),
+            "component-only sender cannot be overridden"
+        );
+        self.args.add_arg(ForgeScriptArg::Sender { address });
+        self.args.add_arg(ForgeScriptArg::Unlocked);
+        Ok(self)
+    }
