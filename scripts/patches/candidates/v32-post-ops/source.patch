+#[cfg(test)]
+mod tests {
+    #[test]
+    fn u32_conversion_matches_the_guest_address_width() {
+        for (limbs, expected) in [
+            ([0, 0, 0, 0], Some(0)),
+            ([u32::MAX as u64, 0, 0, 0], Some(u32::MAX)),
+            ([1u64 << 32, 0, 0, 0], None),
