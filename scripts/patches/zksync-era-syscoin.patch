+
+    #[test]
+    fn parses_zksync_os_da_commitment_scheme() {
+        // SYSCOIN: bind both zkstack's enum spelling and the persisted server alias to scheme 4.
+        for value in ["BlobsZksyncOS", "BlobsZKsyncOS"] {
+            assert_eq!(value.parse(), Ok(L2DACommitmentScheme::BlobsZksyncOS));
