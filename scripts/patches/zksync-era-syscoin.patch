+// SYSCOIN: Generated zkstack signers must never enter Forge argv or command
+// logs. Give Forge a short-lived encrypted keystore through child-only env.
+struct EphemeralForgeSigner {
+    _directory: TempDir,
+    keystore_path: PathBuf,
+    password_path: PathBuf,
+}
+
+impl EphemeralForgeSigner {
+    fn new(private_key: &H256) -> anyhow::Result<Self> {
+        let directory = tempfile::Builder::new()
+            .prefix("zkstack-forge-signer-")
+            .tempdir()?;
+        #[cfg(unix)]
+        fs::set_permissions(directory.path(), fs::Permissions::from_mode(0o700))?;
+
+        let mut rng = thread_rng();
+        let mut random_password = [0_u8; 32];
+        rng.fill_bytes(&mut random_password);
+        let password = hex::encode(random_password);
+        let keystore_name = "signer.json";
+        LocalWallet::encrypt_keystore(
+            directory.path(),
+            &mut rng,
+            private_key.as_bytes(),
+            password.as_bytes(),
+            Some(keystore_name),
+        )?;
+        let keystore_path = directory.path().join(keystore_name);
+
+        let password_path = directory.path().join("password");
+        let mut options = OpenOptions::new();
+        options.write(true).create_new(true);
+        #[cfg(unix)]
+        options.mode(0o600);
+        options
+            .open(&password_path)?
+            .write_all(password.as_bytes())?;
+
+        #[cfg(unix)]
+        {
+            fs::set_permissions(&keystore_path, fs::Permissions::from_mode(0o600))?;
+            fs::set_permissions(&password_path, fs::Permissions::from_mode(0o600))?;
+        }
+
+        Ok(Self {
+            _directory: directory,
+            keystore_path,
+            password_path,
+        })
+    }
+
+    fn apply<'a>(&self, cmd: Cmd<'a>) -> Cmd<'a> {
+        cmd.env("ETH_KEYSTORE", &self.keystore_path)
+            .env("ETH_PASSWORD", &self.password_path)
+    }
+}
