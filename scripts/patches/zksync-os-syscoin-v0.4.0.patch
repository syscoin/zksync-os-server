+        fn next_byte(random: &mut u64) -> u8 {
+            *random ^= *random >> 12;
+            *random ^= *random << 25;
+            *random ^= *random >> 27;
+            random.wrapping_mul(0x2545_f491_4f6c_dd1d) as u8
+        }
