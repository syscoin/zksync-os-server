# Template for Cargo.toml; run.sh substitutes @ZKSYNC_OS_PATH@ with the
# absolute path of a compatible Syscoin zksync-os checkout.
[package]
name = "slh-dsa-difftest"
version = "0.1.0"
edition = "2021"
publish = false
# SYSCOIN: Keep the standalone OS/Solidity corpus pinned to the draft set.
description = "Differential tests for the Syscoin SLH-DSA-SHA2-128-24 precompile against the shared SP 800-230 IPD conformance corpus used by the Solidity fallback verifier tests."

# Standalone: intentionally not a member of the zksync-os-server workspace,
# because it depends on a separately selected Syscoin zksync-os checkout.
[workspace]

[dev-dependencies]
basic_system = { path = "@ZKSYNC_OS_PATH@/basic_system" }
zk_ee = { path = "@ZKSYNC_OS_PATH@/zk_ee" }
hex = "0.4"
serde = { version = "1", features = ["derive"] }
serde_json = "1"

# The sweep performs hundreds of full verifications (~1600 SHA-256 calls each);
# always optimize.
[profile.test]
opt-level = 3
