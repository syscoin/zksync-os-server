+                    let x := mod(calldataload(add(offset, 0x1a4)), Q_MOD)
+                    let y := mod(calldataload(add(offset, 0x1c4)), Q_MOD)
+                    let xx := mulmod(x, x, Q_MOD)
+                    isValid := and(eq(mulmod(y, y, Q_MOD), addmod(mulmod(x, xx, Q_MOD), 3, Q_MOD)), isValid)
