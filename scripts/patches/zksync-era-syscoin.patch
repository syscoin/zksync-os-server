+
+        assert!(!owner_acceptance_required(governor, Address::zero(), governor).unwrap());
+        assert!(
+            owner_acceptance_required(governor, Address::from_low_u64_be(2), governor).is_err()
+        );
+    }
+
+    #[test]
+    fn pending_owner_must_be_the_intended_governor() {
+        let current = Address::from_low_u64_be(1);
+        let governor = Address::from_low_u64_be(2);
+
+        assert!(owner_acceptance_required(current, governor, governor).unwrap());
+        assert!(owner_acceptance_required(current, Address::zero(), governor).is_err());
+        assert!(owner_acceptance_required(current, Address::from_low_u64_be(3), governor).is_err());
+    }
+
+    #[test]
+    fn deployer_transfer_only_runs_from_the_one_pristine_state() {
+        let deployer = Address::from_low_u64_be(1);
+        let expected = Address::from_low_u64_be(2);
+        let other = Address::from_low_u64_be(3);
+
+        assert!(owner_transfer_required(deployer, Address::zero(), deployer, expected).unwrap());
+        assert!(!owner_transfer_required(deployer, expected, deployer, expected).unwrap());
+        assert!(!owner_transfer_required(expected, Address::zero(), deployer, expected).unwrap());
+        assert!(owner_transfer_required(expected, other, deployer, expected).is_err());
+        assert!(owner_transfer_required(deployer, other, deployer, expected).is_err());
+        assert!(owner_transfer_required(other, Address::zero(), deployer, expected).is_err());
+        assert!(owner_transfer_required(other, expected, deployer, expected).is_err());
+    }
+
+    #[test]
+    fn chain_admin_payload_is_exactly_one_zero_value_accept_call() {
+        let target = Address::from_low_u64_be(7);
+        let payload = chain_admin_accept_owner_calls(target);
+        let call_type = ParamType::Array(Box::new(ParamType::Tuple(vec![
+            ParamType::Address,
+            ParamType::Uint(256),
+            ParamType::Bytes,
+        ])));
+        let decoded = decode(&[call_type], &payload).unwrap();
+        let Token::Array(calls) = &decoded[0] else {
+            panic!("expected Call[]");
+        };
+        assert_eq!(calls.len(), 1);
+        let Token::Tuple(call) = &calls[0] else {
+            panic!("expected Call tuple");
+        };
+        assert_eq!(call[0], Token::Address(target));
+        assert_eq!(call[1], Token::Uint(U256::zero()));
