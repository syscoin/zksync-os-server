+    assert_slh_dsa_sha2_128_24_routes(&slh_dsa_sha2_128_24_existing_test_vector_input(), &expected);
+    assert_slh_dsa_sha2_128_24_routes(&slh_dsa_sha2_128_24_ipd_counter0_input(), &expected);
+}
