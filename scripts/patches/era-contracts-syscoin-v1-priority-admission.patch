+contract SyscoinPriorityCommitRecorder is ISyscoinPriorityCommitPolicy {
+    error CommitRejected();
+
+    address public immutable chain;
+    uint64 public initialBatch;
+    uint64 public initialPriorityCursor;
+    bytes32 public initialStoredHash;
+    bool public rejectCommit;
+    uint256 public frontierAtCommit;
+    bytes32 public hashAtCommit;
+    uint64 public batchNumber;
+    bytes32 public storedHash;
+    uint256 public priorityCount;
+    bytes32 public priorityHash;
+    uint256 public frontierAtRevert;
+    uint256 public keptBatch;
+
+    constructor(address _chain, bool _rejectCommit) {
+        chain = _chain;
+        rejectCommit = _rejectCommit;
+        GettersFacet nativeChain = GettersFacet(_chain);
+        initialBatch = uint64(nativeChain.getTotalBatchesCommitted());
+        initialPriorityCursor = uint64(nativeChain.getFirstUnprocessedPriorityTx());
+        initialStoredHash = nativeChain.storedBatchHash(initialBatch);
+    }
+
+    function setBaseline(uint64 batch, uint64 cursor, bytes32 hash) external {
+        initialBatch = batch;
+        initialPriorityCursor = cursor;
+        initialStoredHash = hash;
+    }
+
+    function recordCommit(uint64 _batchNumber, bytes32 _storedHash, uint256 _priorityCount, bytes32 _priorityHash)
+        external
+    {
+        require(msg.sender == chain);
+        if (rejectCommit) revert CommitRejected();
+        frontierAtCommit = GettersFacet(chain).getTotalBatchesCommitted();
+        hashAtCommit = GettersFacet(chain).storedBatchHash(_batchNumber);
+        batchNumber = _batchNumber;
+        storedHash = _storedHash;
+        priorityCount = _priorityCount;
+        priorityHash = _priorityHash;
+    }
+
+    function recordRevert(uint256 _newLastBatch) external {
+        require(msg.sender == chain);
+        frontierAtRevert = GettersFacet(chain).getTotalBatchesCommitted();
+        keptBatch = _newLastBatch;
+    }
+}
