+            fn hash_n<const M: usize>(
+                &mut self,
+                _address: CompressedAddress,
+                _parts: &[[u8; N]; M],
+            ) -> [u8; N] {
+                self.compressions += sha256_compressions(64 + 22 + M * N) - 1;
