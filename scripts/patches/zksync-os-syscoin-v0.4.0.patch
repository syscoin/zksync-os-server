+/// was still rollback-capable.
+pub fn syscoin_edge_da_refs_root_from_hashes(ref_hashes: &[Bytes32]) -> Bytes32 {
+    let mut root = Bytes32::ZERO;
+    apply_syscoin_edge_da_ref_hashes(&mut root, ref_hashes);
+    root
